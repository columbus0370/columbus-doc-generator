ANTHROPIC_API_KEY=your_anthropic_api_key
CORS_ORIGINS=https://your-app.vercel.app
ENV=production

# Square Webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=your_signature_key

# アクセスキー管理（カンマ区切りで複数可）
VALID_ACCESS_KEYS=

# メール送信（Resend API）
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Columbus AI <noreply@your-domain.com>

# ツールURL
TOOL_URL=https://your-app.vercel.app

# 管理者エンドポイント認証（任意の強力な文字列を設定）
ADMIN_SECRET=your_strong_random_secret
